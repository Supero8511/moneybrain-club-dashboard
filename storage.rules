rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ⚠️ firestore.rules 와 동일하게 유지하세요.
    function SUPER_ADMIN_EMAIL() { return 'idcrazyzz@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function superAdmin() { return signedIn() && request.auth.token.email == SUPER_ADMIN_EMAIL(); }
    function myRole() {
      // ⚠️ "(default)" 가 아니라 "monybrainclub" 이라는 이름의 Firestore 데이터베이스를 사용합니다.
      // js/common.js 의 db 연결과 반드시 동일한 데이터베이스 이름이어야 합니다.
      return firestore.exists(/databases/monybrainclub/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/monybrainclub/documents/users/$(request.auth.uid)).data.role
        : 'member';
    }
    function staff() { return signedIn() && (superAdmin() || myRole() == 'admin' || myRole() == 'staff'); }

    // 운영진 전용 인증사진 자료실 - 업로드/열람 모두 운영진만
    match /staffArchive/{bookId}/{fileName} {
      allow read, write: if staff();
    }

    // 책 표지 - 포털에 노출되므로 누구나 열람, 업로드는 운영진만
    match /covers/{fileName} {
      allow read: if true;
      allow write: if staff();
    }
  }
}
